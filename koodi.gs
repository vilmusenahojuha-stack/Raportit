const META_SHEET="_META",META_PREFIX_LOADNO="lastLoadNumber_",META_PREFIX_ROW="row_",META_PREFIX_SESSION="session_";
const SESSION_HOURS=18,MAX_PIN_FAILURES=8,LOCK_MINUTES=10;
